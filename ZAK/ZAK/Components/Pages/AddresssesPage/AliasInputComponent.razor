@using System.ComponentModel.DataAnnotations;
@using ZAK.DA;


@inject IAddressRepository _addressRepository;
@inject ILogger<AliasInputComponent> _logger;

<TextInput TValue="string" Label="Укр. назва" @bind-Value="AliasValue" @bind-Value:after="UpdateDbData" Variant="Variant.Filled"   />

@code {

    [Parameter] public Address Address { get; set; } = default!; 
    [Parameter] public bool StreetAlias { get; set; }

    protected override void OnParametersSet()
    {
        if (Address.addressAlias is null)
        {
            Address.addressAlias = new AddressAlias();
        }
    }

    private string AliasValue
    {
        get => StreetAlias ? Address.addressAlias!.streetAlias : Address.addressAlias!.buildingAlias;
        set
        {
            if (StreetAlias)
                Address.addressAlias!.streetAlias = value;
            else
                Address.addressAlias!.buildingAlias = value;
        }
    }

    private async Task UpdateDbData()
    {
        _logger.LogInformation($"Updating alias for address with id {Address.Id} to {AliasValue}");

        await _addressRepository.UpdateAsync(Address);
    }
}  
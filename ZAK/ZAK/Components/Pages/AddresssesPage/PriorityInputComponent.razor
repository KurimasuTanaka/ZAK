@using System.ComponentModel.DataAnnotations;
@using ZAK.DA;

@inject IAddressRepository _addressRepository;
@inject ILogger<PriorityInputComponent> _logger;

<NumberInput TValue="double" Label="Приорітет" @bind-Value="@Address.addressPriority!.priority" @bind-Value:after="UpdateDbData" />

@code {
    [Parameter] public Address Address { get; set; } = default!;

    private bool _initialized = false;

    protected override void OnParametersSet()
    {
        if (Address.addressPriority is null)
        {
            Address.addressPriority = new AddressPriority { priority = 0 };
        }
    }

    private async Task UpdateDbData()
    {
        if (!_initialized) 
        {
            _initialized = true;
            return;
        }

        _logger.LogInformation($"Updating priority for address with id {Address.Id} to {Address.addressPriority!.priority}");

        await _addressRepository.UpdateAsync(Address);
        
    }
}

@using ZAK.DA
@using ZAK.Components.Pages.ApplicationsPage;

@inject IApplicationReporisory _applicationRepository;
@inject ICoefficientRepository _coefficientRepository;
@inject ILogger<ApplicationsRatedListModal> _logger;

<style>
    .W10 {
        width: 10%;
    }

    .W5 {
        width: 5%;
    }
</style>


<Modal @ref=applicationsList Title="Выбрать заявку" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <Button Color="ButtonColor.Light" @onclick="LeaveChosenTimeEmpty">Залишити час пустим</Button>

        <Grid TItem="Application" Class="table table-hover table-bordered" Data="applications" AllowDetailView="true"
            AllowFiltering="true" AllowPaging="true" PageSize="100" AllowSorting="true"
            OnRowDoubleClick="AddApplicationToSchedule" AllowRowClick="true"
            style="width: 100%; height: 100%; border-collapse: collapse;">
            <GridColumns >
                @*Id column with set of interactive components*@
                <GridColumn TItem="Application" HeaderText="Id" PropertyName="id" HeaderTextAlignment="Alignment.Center" ColumnClass="@(x => "W5")">
                    <div style="display: flex; flex-direction: column; align-items: center;">
                        @context.id

                        <div style="display: flex; gap: 5px; align-items: center;"> 

                            @if(context.important)
                            {
                                <Icon Name="IconName.LightningChargeFill" Color="BlazorBootstrap.IconColor.Warning" />
                            }

                            @if(context.office)
                            {
                                <Icon Name="IconName.Shop" Color="BlazorBootstrap.IconColor.Danger" />
                            }
                            @if(context.restretching)
                            {
                                <Icon Name="IconName.ArrowRepeat" Color="BlazorBootstrap.IconColor.Primary" />
                            }


                        </div>
                    </div>
                </GridColumn>
                @*↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑*@

                @*Column with name of the district*@
                <GridColumn TItem="Application" HeaderText="Район" PropertyName="districtName" HeaderTextAlignment="Alignment.Center" Filterable="false" ColumnClass="@(x => "W10")"
                    SortKeySelector="item => item.address != null && item.address.district != null ? item.address.district.name : string.Empty">
                    @(context.address != null && context.address.district != null ? context.address.district.name : string.Empty)
                </GridColumn>
 
                @*Column name with name of the street*@
                <GridColumn TItem="Application" HeaderText="Вулиця" PropertyName="streetName" HeaderTextAlignment="Alignment.Center" Filterable="false"
                    SortKeySelector="item => item.address != null ? item.address.streetName : string.Empty">
                    @((context.address != null ? context.address.streetName : string.Empty) + " " + 
                      (context.address != null ? context.address!.building : string.Empty));
                </GridColumn>

                <GridColumn TItem="Application" HeaderText="Статус" PropertyName="stretchingStatus" HeaderTextAlignment="Alignment.Center" Filterable="false"
                    SortKeySelector="item => item.stretchingStatus" ColumnClass="@(x => "W5")">
                    @(context.stretchingStatus.GetDisplayName())
                </GridColumn>



                @*Column for date*@
                <GridColumn TItem="Application" HeaderText="Дата" HeaderTextAlignment="Alignment.Center" Filterable="false" ColumnClass="@(x => "W5")">
                    <span>@context.year.@context.month.@context.day</span>
                </GridColumn>

                <GridColumn TItem="Application" HeaderText="Пріорітет" SortKeySelector="item => item.priority" HeaderTextAlignment="Alignment.Center" Filterable="false" ColumnClass="@(x => "W10")"
                    IsDefaultSortColumn="true" SortDirection="BlazorBootstrap.SortDirection.Descending">
                    <span>@context.priority</span>
                </GridColumn>

                <GridColumn TItem="Application" HeaderText="Доступ" HeaderTextAlignment="Alignment.Center" Filterable="false">

                    @if(context.address is not null) 
                    {
                        @context.address!.equipmentAccess.GetDisplayName();
                    }
                    else 
                    {
                        <span class="text-danger">Не вказано</span>
                    }
                </GridColumn>
 
                <GridColumn TItem="Application" HeaderText="Зручний час" HeaderTextAlignment="Alignment.Center" Filterable="false" ColumnClass="@(x => "W10")">
                    <div style="display: flex; flex-direction: column;">

                    @context.comfortableVisitTime
                    @if(context.inSchedule)
                    {
                        <span class="text-success">Бригада №@(context.brigadeNumber)</span>
                    }
                    </div>
                    

                </GridColumn>
                <GridColumn TItem="Application" HeaderText="" HeaderTextAlignment="Alignment.Center" Filterable="false">
                    <Button Size="ButtonSize.Small" @onclick="@(() => AddApplicationToScheduleOnStretching(context))">На протяжку</Button>
                </GridColumn>

            </GridColumns>

            @*Column for comments section*@
            <GridDetailView TItem="Application">
                @((MarkupString)@context.operatorComment)
                @if (!String.IsNullOrEmpty(context.masterComment) || context.masterComment != "<span></span>")
                {
                    <hr>
                    @((MarkupString)@context.masterComment)
                }
            </GridDetailView>



        </Grid>
    </BodyTemplate>
</Modal>


@code {
    [Parameter] public EventCallback<ApplicationScheduled> ApplicationWasChosen { get; set; }
    [Parameter] public EventCallback<ApplicationScheduled> TimeWasLeftEmpty { get; set; }

    private Modal applicationsList = default!;
    List<Application> applications = new List<Application>();

    int scheduledTime = 0;
    int scheduledBrigadeId = 0;
    public async Task ShowAsync(List<ApplicationScheduled> scheduledApplications, ApplicationScheduled scheduledApplication)
    {
        _logger.LogInformation("Showing applications rated list modal");

        scheduledTime = scheduledApplication.applicationScheduledTime;
        scheduledBrigadeId = scheduledApplication.brigadeId;
        applications = (await _applicationRepository.GetAllAsync(true, true)).ToList();

        //Find near applications
        Application? newApplication1 = applications.FirstOrDefault(x => x.id == FindNearApplication(scheduledApplications.Where(a => a.brigadeId == scheduledBrigadeId).ToList(),
        scheduledTime, -1));
        Application? newApplication2 = applications.FirstOrDefault(x => x.id == FindNearApplication(scheduledApplications.Where(a => a.brigadeId == scheduledBrigadeId).ToList(),
        scheduledTime, 1));

        List<Application> nearApplications = new List<Application>();
        if (newApplication1 != null) nearApplications.Add(newApplication1);
        if (newApplication2 != null) nearApplications.Add(newApplication2);


        //Remove applications that are already in the schedule exept the one that set on stretching
        scheduledApplications = scheduledApplications.Where(x => x.onStretching == false).ToList();
        applications = applications.Where(x => !scheduledApplications.Select(a => a.id).Contains(x.id)).ToList();

        //Get priorities from db
        Dictionary<string, double> priorities = (await _coefficientRepository.GetAllAsync()).ToDictionary(x => x.parameter, x =>
        x.coefficient);

        //Calculate priority for all applications
        for (int i = 0; i < applications.Count; i++) applications[i].CalculateApplicationPriorityLevel(priorities,
        nearApplications);

        await applicationsList.ShowAsync();
    }

    private int FindNearApplication(List<ApplicationScheduled> scheduledApplications, int time, int direction)
    {
        _logger.LogInformation($"Finding near application for time {time} with direction {direction}");

        for (int i = time + direction;; i += direction)
        {
            if (i < 0 || i > 10) // Assuming time is in hours, valid range is 0-23
            {
                _logger.LogInformation($"Time {i} is out of bounds, stopping search");
                break;
            }

            ApplicationScheduled? scheduledApplication = scheduledApplications.Find(x => x.applicationScheduledTime == i);
            
            if(scheduledApplication is not null)
            {
                _logger.LogInformation($"Found near application with time {i}");
                return scheduledApplication.id;
            } 
        }
        return 0;
    }


    public async Task HideAsync()
    {
        await applicationsList.HideAsync();
    }

    public void AddApplicationToSchedule(GridRowEventArgs<Application> application)
    {
        _logger.LogInformation($"Adding application with ID {application.Item.id} to schedule at time {scheduledTime} for brigade ID {scheduledBrigadeId}");

        ApplicationScheduled scheduledApplication = new ApplicationScheduled()
        {
            id = application.Item.id,
            applicationScheduledTime = scheduledTime,
            brigadeId = scheduledBrigadeId
        };

        ApplicationWasChosen.InvokeAsync(scheduledApplication);
    }

    public void AddApplicationToScheduleOnStretching(Application application)
    {
        _logger.LogInformation($"Adding application with ID {application.id} to schedule on stretching at time {scheduledTime} for brigade ID {scheduledBrigadeId}");

        ApplicationScheduled scheduledApplication = new ApplicationScheduled()
        {
            id = application.id,
            applicationScheduledTime = scheduledTime,
            brigadeId = scheduledBrigadeId, 
            onStretching = true
        };

        ApplicationWasChosen.InvokeAsync(scheduledApplication);
    }

    public void LeaveChosenTimeEmpty()
    {
        _logger.LogInformation($"Leaving time {scheduledTime} empty for brigade ID {scheduledBrigadeId}");

        ApplicationScheduled scheduledApplication = new ApplicationScheduled()
        {
            id = -1,
            applicationScheduledTime = scheduledTime,
            brigadeId = scheduledBrigadeId
        };

        TimeWasLeftEmpty.InvokeAsync(scheduledApplication);
    }

}
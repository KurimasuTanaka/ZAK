@using System.Numerics
@using ZAK.DA
@using ZAK.DAO;
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using ZAK.MapRoutesManager
@using ZAK.Services.ScheduleManagerService
@using ZAK.Services.UnresolvedAddressesChecker

@rendermode InteractiveAuto

@inject IJSRuntime Js

@inject IMapRoutesManager mapRoutesManager
@inject IApplicationReporisory _applicationRepository;
@inject IBrigadeRepository _brigadeRepository;

@inject IScheduleManager _scheduleManager;
@inject ILogger<MapComponentLeaflet> _logger;

@inject IUnresolvedAddressesChecker _unresolvedAddressesChecker;


<div id="map">placeholder</div>


<style>
    #map {
        height: 900px;
    }

    .div-icon-reg-str {
        border: 3px solid #00C853;
        background-color: #2962FF;
        border-radius: 50%;
        text-align: center;
    }

    .div-icon-reg-nstr {
        border: 3px solid #424242;
        background-color: #2962FF;
        border-radius: 50%;
        text-align: center;
    }

    .div-icon-imp-str {
        border: 3px solid #00C853;
        background-color: #D50000;
        border-radius: 50%;
        text-align: center;
        padding: 5px;
    }

    .div-icon-imp-nstr {
        border: 3px solid #424242;
        background-color: #D50000;
        border-radius: 50%;
        text-align: center;
        padding: 5px;
    }
</style>
@code {
    bool isInitialized = false;

    protected override void OnInitialized()
    {
      var _objRef = DotNetObjectReference.Create(this);
        
        Js.InvokeVoidAsync("leafleatMapController", _objRef);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _logger.LogInformation("MapComponentLeaflet is rendered for the first time");

            isInitialized = true;

            await Js.InvokeVoidAsync("initMap");

            if (! (await _unresolvedAddressesChecker.GetUnresolvedAddressesInfo()).unresolvedAddressesExist)
            {
                _logger.LogInformation("No unresolved addresses found, drawing map elements");
                await DrawPaths();
                await DrawMarkers();
            }
        }

    }

    public async Task DrawMarkers()
    {
        if (!isInitialized)
        {
            _logger.LogWarning("MapComponentLeaflet is not initialized, cannot draw markers");
            return;
        }

        _logger.LogInformation("MapComponentLeaflet is drawing markers");


        List<Application> applications = (await _applicationRepository.GetAllAsync(true)).
        Where(a => a.address is not null && a.address.coordinates is not null).
        ToList();

        int brigadeCount = (await _brigadeRepository.GetAllAsync()).Count();

        foreach (var application in applications)
        {
            var temp = new
            {
                lat = application.address!.coordinates!.lat,
                lon = application.address.coordinates.lon,
                id = application.id,
                stretchingStatus = application.stretchingStatus,
                hot = application.important,
                operatorComment = application.operatorComment,
                masterComment = application.masterComment,
                streetName = application.address.streetName,
                houseNumber = application.address.building,
                brigadeCount = brigadeCount
            };

            try
            {
                await Js.InvokeVoidAsync("drawMarker", JsonSerializer.Serialize(temp));
            }
            catch (Exception e)
            {
                _logger.LogError("Error while drawing marker: {Message}", e.Message);
                return;
            }
        }

    }

    public async Task DrawPaths()
    {
        if (!isInitialized)
        {
            _logger.LogWarning("MapComponentLeaflet is not initialized, cannot draw paths");
            return;
        }

        _logger.LogInformation("MapComponentLeaflet is drawing paths");

        List<List<Vector2>> routes = await mapRoutesManager.GetRoutesAsync();
        for (int i = 0; i < routes.Count; i++)
        {
            await DrawPath(routes[i], i);
        }
    }

    public async Task DrawPath(List<Vector2> path, int brigadeNumber)
    {


        _logger.LogInformation("MapComponentLeaflet is drawing paths");

        string pathString = "";
        foreach (var point in path)
        {
            pathString += point.X + " " + point.Y + " ";
            int l = pathString.Length;
        }

        string color = "red"; // Default color in case brigadeNumber is not recognized
        switch (brigadeNumber)
        {
            case 0: color = "#1C3144"; break;
            case 1: color = "#761922"; break;
            case 2: color = "#D00000"; break;
            case 3: color = "#E85D04"; break;
            case 4: color = "#FFBA08"; break;
            case 5: color = "#3F88C5"; break;
        }

        try
        {
            await Js.InvokeVoidAsync("drawPath", pathString, color);
        }
        catch (Exception e)
        {
            _logger.LogError("Error while drawing path: {Message}", e.Message);
            return;
        }
    }

    public async Task RefreshMap()
    {
        if (!isInitialized)
        {
            _logger.LogWarning("MapComponentLeaflet is not initialized, cannot refresh map");
            return;
        }

        _logger.LogInformation("Refreshing map in MapComponentLeaflet component");

        try
        {
            await Js.InvokeVoidAsync("clearMap");
        }
        catch (Exception e)
        {
            _logger.LogError("Error while clearing map: {Message}", e.Message);
            return;
        }

        await DrawPaths();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task ScheduleApplicationToBrigade(int brigadeId, int applicationId)
    {
        _logger.LogInformation($"Scheduling application with ID {applicationId} to brigade with ID {brigadeId}");

        await _scheduleManager.ScheduleApplicationToFirstEmptyTime(brigadeId, applicationId);
    }

}

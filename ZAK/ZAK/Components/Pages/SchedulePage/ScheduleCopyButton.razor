@inject IJSRuntime JSRuntime;
@inject IBrigadeRepository _brigadeRepository;
@inject ILogger<ScheduleCopyButton> _logger;

<Button @onclick="CopyShedule">Скопіювати графік</Button>

@code {
    private async Task CopyShedule(MouseEventArgs args)
    {
        _logger.LogInformation("Copying brigade schedule to clipboard...");

        string brigadeInChatFormat = "";

        List<Brigade> brigades = (await _brigadeRepository.GetAllAsync()).ToList();

        for (int i = 0; i < brigades.Count; i++)
        {

            brigadeInChatFormat += "Бригада " + (i + 1).ToString() + "\n";
            List<ApplicationScheduled> scheduledApplications = brigades[i].GetApplications();

            int applicationCounter = 0;
            foreach (ApplicationScheduled application in scheduledApplications)
            {

                if (application.id == 0)
                {
                    brigadeInChatFormat +=
                    (applicationCounter + 10).ToString() + " - " + (applicationCounter + 11).ToString() + " " +
                    "----- Резерв -----\n";
                }
                else
                {
                    brigadeInChatFormat +=
                    (applicationCounter + 10).ToString() + " - " + (applicationCounter + 11).ToString() + " " +
                    application.id + " " + 
                    ClearSteetName(application.address!.streetName) + " " +
                    application.address!.building + " (" +  
                    application.comfortableVisitTime + " " +
                    (application.office ? "ОФІС " : "") +
                    application.address.equipmentAccess.GetDisplayName() + ") " +
                    (application.inSchedule ? "ДОМОВЛЕНО " : "") + '\n'; 
                }

                applicationCounter++;
            }

            _logger.LogInformation("Brigade string generated successfully. \nInvoking clipboard function... ");

            await JSRuntime.InvokeVoidAsync("CopyToClipboard", brigadeInChatFormat);

        }
    }

    private string ClearSteetName(string streetName)
    {
        if (string.IsNullOrEmpty(streetName))
        {
            return string.Empty;
        }

        int bracketIndex = streetName.IndexOf('(');
        int dotIndex = streetName.IndexOf('.');

        if(bracketIndex == -1) bracketIndex = streetName.Length;
        if(dotIndex == -1) dotIndex = 0;

        return streetName.Substring(dotIndex + 1, bracketIndex - (dotIndex + 1)).Trim();
    }
}

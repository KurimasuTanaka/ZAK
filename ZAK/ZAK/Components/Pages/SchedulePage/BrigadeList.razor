@using MudBlazor.Utilities
@using ZAK.DA;
@using MudBlazor
@using ZAK.Services.ScheduleManagerService

@inject IBrigadeRepository _brigadeRepository;
@inject IScheduleManager _brigadesManager;
@inject ILogger<BrigadeList> _logger;

<ApplicationsRatedListModal @ref="applicationsRatedList" applicationWasChosen="ApplicationWasChosen"
    TimeWasLeftEmpty="TimeWasLeftEmpty" />


<MudExpansionPanels MultiExpansion="true">
    <MudDropContainer @ref="dropContainer" T="ApplicationScheduled" Items="@applications"
        ItemsSelector="@((item, dropzone) => item.brigadeId.ToString() == dropzone)" ItemDropped="ItemDroppedHandler">
        <ChildContent>
            @{
                int brigadeNumber = 0;
            }
            @foreach (Brigade brigade in brigades)
            {
                ++brigadeNumber;
                var dropzone = brigade.id.ToString();
                <MudExpansionPanel Text="@($"Бригада {brigadeNumber}")">
                    <MudList T="ApplicationScheduled" Class="d-flex flex-column mud-height-full">
                        <MudDropZone T="ApplicationScheduled" AllowReorder="true" Identifier="@dropzone"
                            Class="flex-grow-1" />
                    </MudList>
                </MudExpansionPanel>
            }
        </ChildContent>
        <ItemRenderer>
            @{
                //Add time info
                var scheduledApplicationText = $"{context.applicationScheduledTime + 10} - {context.applicationScheduledTime + 11} | ";
                
                if(context.id != 0)
                {
                    scheduledApplicationText += $"{@context.id} -";
                    
                    //If address is not null, add address info
                    if(context.address is not null)
                    {
                        if (context.address.district is not null)
                        {
                            scheduledApplicationText += $" {@context.address!.district!.name} - ";
                        }

                        scheduledApplicationText += $"{context.address.streetName} {context.address.building}";
                    
                        scheduledApplicationText += $" - {context.address.equipmentAccess.GetDisplayName()}";
                    }

                    //Add comfortable visit time if brigade is not for stretching

                    if (context.office)
                    {
                        scheduledApplicationText += $" - ОФІС";
                    }

                    if(context.inSchedule)
                    {
                        scheduledApplicationText += $" - ДОМОВЛЕНО";
                    } else if (context.onStretching)
                    {
                        scheduledApplicationText += $" - ПРОТЯЖКА";
                    }

                    if (!context.onStretching)
                    {
                        scheduledApplicationText += $" - {context.comfortableVisitTime}";    
                    } 
                } else 
                {
                    scheduledApplicationText += " РЕЗЕРВ";
                }
            }
            <MudListItem T="ApplicationScheduled"
                Text="@scheduledApplicationText"
                OnClick="@(async () => { await ShowSortedApplicationsListModal(context); })" />


        </ItemRenderer>
    </MudDropContainer>
</MudExpansionPanels>
@code {
    [Parameter] public EventCallback RefreshMap { get; set; }
    MudDropContainer<ApplicationScheduled> dropContainer = default!;
    private List<Brigade> brigades = new();
    private List<ApplicationScheduled> applications = new();
    
    ApplicationsRatedListModal applicationsRatedList = default!;

    private async Task ItemDroppedHandler(MudItemDropInfo<ApplicationScheduled> dropItem)
    {
        _logger.LogInformation($"Item dropped in dropzone {dropItem.DropzoneIdentifier} at index {dropItem.IndexInZone}");


        if(dropItem == null || dropItem.Item == null || dropItem.DropzoneIdentifier == null)
        {
            _logger.LogWarning("Drop item or its properties are null. Cannot process the drop.");
            return;
        }

        int editedBrigadeId = Int32.Parse(dropItem.DropzoneIdentifier);
        if(dropItem.Item.brigadeId != editedBrigadeId)
        {
            _logger.LogWarning($"Scheduled application moved to the same brigade");
            return;
        }

        //TODO: Consider to move this logic to the service
        //Creating a separate list of brigade schedule and reordering it
        List<ApplicationScheduled> brigadeSchedule = applications.Where(a => a.brigadeId == editedBrigadeId)
            .ToList();
        brigadeSchedule.UpdateOrder<ApplicationScheduled>(dropItem, app => app.applicationScheduledTime);

        Brigade brigade = brigades.FirstOrDefault(b => b.id == editedBrigadeId)!;

        brigade.scheduledApplications = brigadeSchedule
            .Where(a => a.id != 0)
            .Select(a => new ZAK.Db.Models.ScheduledApplicationModel
            {
                applicationId = a.id,
                brigadeId = a.brigadeId,
                scheduledTime = a.applicationScheduledTime,
            })
            .ToList();

        await _brigadeRepository.UpdateAsync(brigade);
    }

    private async Task ApplicationWasChosen(ApplicationScheduled scheduledApplication)
    {
        await _brigadesManager.ScheduleApplication(
        scheduledApplication.id,
        scheduledApplication.brigadeId,
        scheduledApplication.applicationScheduledTime, 
        scheduledApplication.onStretching);


        ApplicationScheduled? application = applications.Where(a => a.brigadeId == scheduledApplication.brigadeId && 
            a.applicationScheduledTime == scheduledApplication.applicationScheduledTime).FirstOrDefault();

        if (application is not null)
        {
            application.Copy(scheduledApplication);
            application.applicationScheduledTime = scheduledApplication.applicationScheduledTime;
        }

        dropContainer.Refresh();
        await RefreshMap.InvokeAsync();

        //Hiding modal window
        await applicationsRatedList.HideAsync();
    }

    private async Task TimeWasLeftEmpty(ApplicationScheduled scheduledTime)
    {
        await _brigadesManager.MakeTimeSlotEmpty(scheduledTime.brigadeId, scheduledTime.applicationScheduledTime);

        ApplicationScheduled? application = applications.Where(a => a.brigadeId == scheduledTime.brigadeId && 
            a.applicationScheduledTime == scheduledTime.applicationScheduledTime).FirstOrDefault();

        if (application is not null)
        {
            application.id = 0; 
        }

        dropContainer.Refresh();
        await RefreshMap.InvokeAsync();

        //Hiding modal window
        await applicationsRatedList.HideAsync();
    }

    private async Task ShowSortedApplicationsListModal(ApplicationScheduled scheduledApplication)
    {
        _logger.LogInformation("Button on application was pressed. Opening modal window with applications list...");

        await applicationsRatedList.ShowAsync(applications.Where(a => a.id != 0).ToList(),
        scheduledApplication);
    }


    public async Task DeleteBrigade(int brigadeId)
    {
        applications.RemoveAll(a => a.brigadeId == brigadeId);
        brigades.RemoveAll(b => b.id == brigadeId);

        await RefreshMap.InvokeAsync();
        dropContainer.Refresh();
    }

    public async Task RefreshApplicationsList()
    {
        _logger.LogInformation("Getting all brigades to update list of scheduled applications");

        brigades = (await _brigadeRepository.GetAllAsync()).ToList();

        applications.Clear();
        foreach (var brigade in brigades)
        {
            applications.AddRange(brigade.GetApplications());
        }
        dropContainer.Refresh();

        await RefreshMap.InvokeAsync();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _logger.LogInformation("Parameters set for BrigadeList component. Getting applications to render brigade list");
            
            brigades = (await _brigadeRepository.GetAllAsync()).ToList();

            foreach (var brigade in brigades)
            {
                applications.AddRange(brigade.GetApplications());
            }
            dropContainer.Refresh();
            StateHasChanged();  
        }
    }

}
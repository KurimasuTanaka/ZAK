@page "/applications"
@rendermode InteractiveServer

@using ZAK.DA;
@using BlazorApp.Enums;
@using BlazorBootstrap;
@using Microsoft.AspNetCore.Authorization
@using ZAK.Components.Pages.ApplicationsPage.ApplicationsActivities;

@using System.Diagnostics;
@inject IApplicationReporisory _applicationRepository;
@inject IWebHostEnvironment enviroment;

@inject ILogger<Applications> _logger;

<PageTitle>Заявки</PageTitle>


<ApplicationEditorModal @ref="applicationEditorModal" />


<Card class="my-3">
  <CardBody>
    <ApplicationsActivities ApplicationsInformationWasChanged="Redraw" />
    <Switch Label="Показувати тільки оновлені" @bind-Value="showUpdated" @bind-Value:after="Redraw" />
    <Switch Label="Показувати ігноровані" @bind-Value="showIgnored" Disabled="@showUpdated"
      @bind-Value:after="Redraw" />
  </CardBody>
</Card>

<Grid @ref="applicationsGrid" TItem="Application" Class="table table-hover table-bordered"
  DataProvider="ApplicationsDataProvider" AllowFiltering="true" AllowPaging="true" PageSize="40" AllowSorting="true"
  SelectionMode="GridSelectionMode.Multiple" Responsive="true">

  @*Id column with set of interactive components*@
  <GridColumn TItem="Application" HeaderText="№" PropertyName="id" SortKeySelector="item => item.id"
    HeaderTextAlignment="Alignment.Center">
    <div class="d-flex justify-content-left align-items-center">
      @context.id
      <Button @onclick="@(mouseArg => applicationEditorModal.ShowModal(context))">
        <Icon Name="IconName.Pencil" Size="IconSize.x6" />
      </Button>
      <ApplicationDeletionIcon Application="@context" />
    </div>
    <ApplicationWasChangedIcon application="@context" />
    @*Interactive components in Id section ↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓*@

    <MudSwitch Size="Size.Small" Color="Color.Info" LabelPlacement="MudBlazor.Placement.Right" Label="Ігнорувати"
      @bind-Value="@context.ignored"
      @bind-Value:after="@(async () => await _applicationRepository.UpdateAsync(context))" />

    <MudSwitch Size="Size.Small" Color="Color.Info" LabelPlacement="MudBlazor.Placement.Right" Label="Закопана"
      @bind-Value="@context.buried"
      @bind-Value:after="@(async () => await _applicationRepository.UpdateAsync(context))" />


    <MudSwitch Size="Size.Small" Color="Color.Info" LabelPlacement="MudBlazor.Placement.Right" Label="Важлива заявка"
      @bind-Value="@context.important"
      @bind-Value:after="@(async () => await _applicationRepository.UpdateAsync(context))" />


    <TimeframeApplicationComponent applicationId="@context.id" firstPart="@context.firstPart"
      secondPart="@context.secondPart" timeRangeIsSet="@context.timeRangeIsSet" startHour="@context.startHour"
      endHour="@context.endHour">
    </TimeframeApplicationComponent>
  </GridColumn>
  @*↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑*@

  @*Interactivity column*@
  <GridColumn TItem="Application" HeaderText="Параметри" HeaderTextAlignment="Alignment.Center" Filterable="false">

    <MudSwitch Size="Size.Small" Color="Color.Info" LabelPlacement="MudBlazor.Placement.Right"
      Label="Цікавився статусом" @bind-Value="@context.statusWasChecked"
      @bind-Value:after="@(async () => await _applicationRepository.UpdateAsync(context))" />

    <MudSwitch Size="Size.Small" Color="Color.Info" LabelPlacement="MudBlazor.Placement.Right" Label="Срочка"
      @bind-Value="@context.urgent"
      @bind-Value:after="@(async () => await _applicationRepository.UpdateAsync(context))" />

    <MudSwitch Size="Size.Small" Color="Color.Info" LabelPlacement="MudBlazor.Placement.Right" Label="Є вільний кабель"
      @bind-Value="@context.freeCable"
      @bind-Value:after="@(async () => await _applicationRepository.UpdateAsync(context))" />

    <MudSwitch Size="Size.Small" Color="Color.Info" LabelPlacement="MudBlazor.Placement.Right" Label="Зміна тарифу"
      @bind-Value="@context.tarChangeApp"
      @bind-Value:after="@(async () => await _applicationRepository.UpdateAsync(context))" />

    <MudSwitch Size="Size.Small" Color="Color.Info" LabelPlacement="MudBlazor.Placement.Right" Label="Перетяжка"
      @bind-Value="@context.restretching"
      @bind-Value:after="@(async () => await _applicationRepository.UpdateAsync(context))" />


    <hr>

    <MudSwitch Size="Size.Small" Color="Color.Info" LabelPlacement="MudBlazor.Placement.Right" Label="Підключення офісу"
      @bind-Value="@context.office"
      @bind-Value:after="@(async () => await _applicationRepository.UpdateAsync(context))" />

    <MudSwitch Size="Size.Small" Color="Color.Success" LabelPlacement="MudBlazor.Placement.Right" Label="Домовлена"
      @bind-Value="@context.inSchedule"
      @bind-Value:after="@(async () => await _applicationRepository.UpdateAsync(context))" />

    @if(context.inSchedule)
    {
      <MudTextField @bind-Value="@context.brigadeNumber" Label="Номер бригади" Variant="Variant.Outlined" @bind-Value:after="@(async () => {await _applicationRepository.UpdateAsync(context);})"  />
    }

  <hr>

    <InputDeadlineComponent applicationId="@context.id" daysForConnection="@context.maxDaysForConnection" />
  </GridColumn>

  @*↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑*@

  @*Column name with name of the street*@
  <GridColumn TItem="Application" HeaderText="Адреса" PropertyName="streetName" TextAlignment="Alignment.Center"
    HeaderTextAlignment="Alignment.Center">

    @if (context.address is not null)
    {
      if (context.address.district is not null)
      {
        <h6>@(context.address!.district!.name)</h6>
        <br>
      }
      @(context.representableAddress)

    }
    else
    {

      <span class="text-danger">Адреса не вказана</span>
    }
  </GridColumn>

  @*Column with stretching status ↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓*@
  <GridColumn style="width: 10%;" TItem="Application" HeaderText="Статус" PropertyName="stretchingStatus" Filterable="false"
    HeaderTextAlignment="Alignment.Center" SortKeySelector="item => item.stretchingStatus"
    TextAlignment="Alignment.Center"
    ColumnClass="@(x => StretchingStatusComponent.GetStrechingStatusClass(x.stretchingStatus))">

    <StretchingStatusComponent applicationId="@context.id" stretchingStatus="@context.stretchingStatus" />
  </GridColumn>
  @*↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑*@

  @*Column for comments section*@
  <GridColumn TItem="Application" HeaderText="Коментар" PropertyName="operatorComment" Filterable="false"
    HeaderTextAlignment="Alignment.Center">
    <div style="max-height: 20em; overflow: auto;">
      @((MarkupString)@context.operatorComment)
      @if (!String.IsNullOrEmpty(context.masterComment) && context.masterComment != "<span></span>")
      {
        <hr>
        @((MarkupString)@context.masterComment)
      }
    </div>
  </GridColumn>

  @*Column for date*@
  <GridColumn TItem="Application" HeaderText="Дата" style="width: 15%;" HeaderTextAlignment="Alignment.Center" Filterable="false"
    Sortable="true" SortKeySelector="item => new DateTime(item.year, item.month, item.day)">
    <span>@context.year.@context.month.@context.day</span>
    <span>
      <h6>Дней к дедлайну: </h6> @context.daysToDeadline
    </span>
  </GridColumn>
</Grid>

@code {
  private bool showIgnored = true;

  ApplicationEditorModal applicationEditorModal = default!;

  private Grid<Application> applicationsGrid = default!;
  private bool showUpdated = false;

  public async Task Redraw()
  {
    _logger.LogInformation("Redrawing applications table");

    await applicationsGrid.RefreshDataAsync();
  }

  private async Task<GridDataProviderResult<Application>> ApplicationsDataProvider(GridDataProviderRequest<Application>
  request)
  {
    _logger.LogInformation("Loading applications data");

    List<Application> applications;

    if (showUpdated)
    {
      applications = (await _applicationRepository.GetAllUpdatedAsync()).ToList();
    }
    else
    {
      if (showIgnored) applications = (await _applicationRepository.GetAllAsync()).ToList();
      else
      {
        applications = (await _applicationRepository.GetAllWithIgnoringAsync()).ToList();
      }
    }
    return await Task.FromResult(request.ApplyTo(applications));
  }



}

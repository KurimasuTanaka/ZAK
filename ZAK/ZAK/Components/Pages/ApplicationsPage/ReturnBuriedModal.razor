@inject IApplicationReporisory _applicationRepository;

<Modal @ref="modal" title="Повернення заявки" Fullscreen="ModalFullscreen.MediumDown">
    <BodyTemplate>
        <MudNumericField @bind-Value="@_applicationId" Label="Номер заявки" Variant="Variant.Outlined" />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="async () => await ReturnApplicationAsync()">
            Повернути</MudButton>

    </BodyTemplate>
</Modal>

@code {
    int _applicationId = 0;

    private Modal modal = default!;

    private async Task ReturnApplicationAsync()
    {
        Application application = await _applicationRepository.GetByIdAsync(_applicationId);

        if (application == null)
        {
            return;
        }

        application.buried = false;
        await _applicationRepository.UpdateAsync(application);
    
        await modal.HideAsync();
    }

    public async Task ShowModal()
    {
        await modal.ShowAsync();
    }
}

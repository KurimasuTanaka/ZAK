@using System.Text
@inject IApplicationReporisory _applicationRepository;
@inject ILogger<ApplicationWasChangedIcon> _logger;

@if (application.applicationWasUpdated)
{
    <Tooltip Title="@_changesReport.ToString()" IsHtml="true" Placement="TooltipPlacement.Top">

        <Button @onclick="UpdateConfirmed">
            <Icon Name="IconName.ExclamationDiamondFill" Size="IconSize.x5"  Color="IconColor.Warning" />
        </Button>
    </Tooltip>
}

@code {
    [Parameter] public Application application { get; set; } = default!;

    private StringBuilder _changesReport = new("Було змінено: <br>"); 
    protected override void OnParametersSet()
    {
        if(application.operatorCommentWasUpdated)
        {
            _changesReport.Append("- Коментар оператора <br>");
        }
        if(application.masterCommentWasUpdated)
        {
            _changesReport.Append("- Коментар майстра <br>");
        }
        if(application.statusWasUpdated)
        {
            _changesReport.Append("- Статус заявки <br>");
        }
        if(application.addresWasUpdated)
        {
            _changesReport.Append("- Адреса заявки <br>");
        }
    }

    private async Task UpdateConfirmed()
    {
        _logger.LogInformation($"Setting status that changes made to application with Id {application.id} were confirmed");

        application.operatorCommentWasUpdated = false;
        application.masterCommentWasUpdated = false;
        application.statusWasUpdated = false;
        application.addresWasUpdated = false;

        await _applicationRepository.UpdateAsync(
            application);
    }
}